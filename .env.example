# Copy to .env.local and fill in.

# Where validated enquiry submissions are forwarded. Any endpoint that accepts a
# JSON POST will do: an email relay, a CRM inbox, or an automation webhook.
#
# Until this is set, the enquiry form validates input but reports honestly that
# delivery is not configured and points the visitor at the phone number, rather
# than showing a success message for a message that went nowhere.
LEAD_WEBHOOK_URL=

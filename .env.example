# Copy to .env.local and fill in.

# Where validated enquiry submissions are forwarded. Any endpoint that accepts a
# JSON POST will do: an email relay, a CRM inbox, or an automation webhook.
#
# Until this is set, the enquiry form validates input but reports honestly that
# delivery is not configured and points the visitor at the phone number, rather
# than showing a success message for a message that went nowhere.
LEAD_WEBHOOK_URL=

# Google Search Console HTML-tag verification (content= value only).
# Enables <meta name="google-site-verification"> on every page.
GOOGLE_SITE_VERIFICATION=

# 10GB VPS: leave unset. Long-tail pages stay in the sitemap and render on demand.
# AVENSAFE_FULL_SSG=1
# Write ISR HTML to disk (fills the disk if Google crawls millions of URLs):
# AVENSAFE_ISR_DISK=1
